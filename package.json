{
  "name": "sample-spec-kit",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:contract": "npm run test:contract --workspace backend --if-present",
    "test:integration": "npm run test:integration --workspace backend --if-present",
    "db:setup": "npm run db:setup --workspace backend --if-present"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.2",
    "typescript": "^5.8.2"
  }
}
